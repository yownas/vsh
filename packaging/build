#!/usr/bin/env bash
#
# build: build the vsh RPM, deb and apk packages with nfpm from the working tree.
#
# Usage: packaging/build [-o <dir>] [-f rpm|deb|apk] [client|host|proxy ...]
#   With Nix:  nix run .#packages -- [options] [package ...]
#
#   -o <dir>   output directory (default build/packages)
#   -f <fmt>   rpm, deb or apk; repeat for several (default all)
#
# Packages (default: all three):
#   client  vsh        the vsh client and contrib tools
#   host    vsh-host   vshd and the Linux backend under /opt/vsh
#   proxy   vsh-proxy  proxy-clients and /opt/vsh/bin/vsh (needs vsh and vsh-host)
#
# The version comes from the newest v<version> tag. A build of a tagged
# commit gets release 1 (1.3.2-1, apk 1.3.2-r1); later commits get
# 1.3.2-1.<commits>.git<sha> (apk 1.3.2_p<commits>-r1), which sorts after
# the tag and before the next version.
#
# Set VSH_MAINTAINER ("Name <email>") for the deb Maintainer field.

set -euo pipefail

usage() {
  echo "usage: build [-o <dir>] [-f rpm|deb|apk] [client|host|proxy ...]" >&2
  exit 2
}

outdir=build/packages
formats=()
while getopts o:f: opt; do
  case $opt in
    o) outdir=$OPTARG ;;
    f)
      case $OPTARG in
        rpm | deb | apk) formats+=("$OPTARG") ;;
        *) echo "build: unknown format '$OPTARG' (expected rpm, deb or apk)" >&2; exit 2 ;;
      esac
      ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))
[ $# -gt 0 ] || set -- client host proxy
[ ${#formats[@]} -gt 0 ] || formats=(rpm deb apk)

for pkg in "$@"; do
  case $pkg in
    client | host | proxy) ;;
    *) echo "build: unknown package '$pkg' (expected client, host or proxy)" >&2; exit 2 ;;
  esac
done

root=$(git rev-parse --show-toplevel)
outdir=$(realpath -m "$outdir")
cd "$root"

desc=$(git describe --tags --long --match '[vV][0-9]*' 2>/dev/null) ||
  desc="v0-$(git rev-list --count HEAD)-g$(git rev-parse --short HEAD)"
if [[ ! $desc =~ ^[vV]([0-9][0-9.]*)-([0-9]+)-g([0-9a-f]+)$ ]]; then
  echo "build: cannot parse a version from '$desc'" >&2
  exit 1
fi
version=${BASH_REMATCH[1]}
commits=${BASH_REMATCH[2]}
sha=${BASH_REMATCH[3]}
export VSH_MAINTAINER=${VSH_MAINTAINER:-vsh developers <https://github.com/yownas/vsh>}
# Reproducible timestamps in the packages
SOURCE_DATE_EPOCH=$(git log -1 --format=%ct)
export SOURCE_DATE_EPOCH

mkdir -p "$outdir"
for fmt in "${formats[@]}"; do
  # apk wants an integer release, so a snapshot goes into the version as
  # _p<commits> (sorts after the tag) and the sha is left out.
  export VSH_VERSION=$version VSH_RELEASE=1
  if [ "$commits" != 0 ]; then
    case $fmt in
      apk) VSH_VERSION=${version}_p$commits ;;
      *) VSH_RELEASE=1.$commits.git$sha ;;
    esac
  fi
  for pkg in "$@"; do
    nfpm package --config "packaging/nfpm/$pkg.yaml" --packager "$fmt" --target "$outdir"
  done
done
